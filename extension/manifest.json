{
  "manifest_version": 3,
  "name": "Innebandystats",
  "version": "0.7.1",
  "description": "Serietabeller, poängligor och matchanalys direkt på stats.innebandy.se.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "tabs", "alarms"],
  "host_permissions": ["https://stats.innebandy.se/*", "https://innebandy.azurewebsites.net/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Visa Innebandystats",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://stats.innebandy.se/*"],
      "js": ["src/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://stats.innebandy.se/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://innebandy.azurewebsites.net/*", "http://localhost/*"],
      "js": ["src/app-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
