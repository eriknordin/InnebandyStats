@model InnebandyStats.Models.MatchesViewModel
@{
    ViewData["Title"] = Model.CompetitionName + " – Matcher";
    var now = InnebandyStats.Services.MatchState.SwedishNow;
}

<div class="container mt-4">
    <h1 class="mb-1">
        <a id="seriesLink" href="#" target="_blank" class="text-decoration-none">@Model.CompetitionName</a>
        <button class="btn btn-sm ms-2 fav-btn fav-series-btn"
                data-id="@Model.CompetitionId"
                data-name="@Model.CompetitionName"
                title="Favoritmarkera serien">☆</button>
    </h1>

    <partial name="_SeriesTabs" model="Model.CompetitionId" view-data='new ViewDataDictionary(ViewData) { ["SeriesTab"] = "Matches" }' />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <partial name="_ErrorAlert" model="Model.ErrorMessage" />
    }

    @if (Model.AvailableTeams.Count > 0)
    {
        <form method="get" asp-action="Matches" class="mb-3">
            <input type="hidden" name="id" value="@Model.CompetitionId" />
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-6 col-md-4">
                    <label for="teamFilter" class="form-label small text-muted mb-1">Lag</label>
                    <select id="teamFilter" name="team" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Alla lag</option>
                        @foreach (var t in Model.AvailableTeams)
                        {
                            <option value="@t" selected="@(t == Model.FilterTeam)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <label for="sortSelect" class="form-label small text-muted mb-1">Sortering</label>
                    <select id="sortSelect" name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="date" selected="@(Model.SortBy == "date")">Datum (äldst först)</option>
                        <option value="date_desc" selected="@(Model.SortBy == "date_desc")">Datum (senast först)</option>
                        <option value="round" selected="@(Model.SortBy == "round")">Per omgång</option>
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(Model.FilterTeam))
                {
                    <div class="col-auto">
                        <a asp-action="Matches" asp-route-id="@Model.CompetitionId"
                           asp-route-sort="@(Model.SortBy == "date" ? null : Model.SortBy)"
                           class="btn btn-sm btn-outline-secondary">Rensa filter</a>
                    </div>
                }
            </div>
            <noscript><button type="submit" class="btn btn-sm btn-primary mt-2">Visa</button></noscript>
        </form>
    }

    @if (Model.Matches.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-info">Inga matcher hittades för denna serie.</div>
    }

    @if (Model.Matches.Count > 0)
    {
        var grouped = Model.SortBy == "round"
            ? Model.Matches.GroupBy(m => string.IsNullOrEmpty(m.RoundName) ? $"Omgång {m.Round}" : m.RoundName).ToList()
            : Model.Matches.GroupBy(m => m.MatchDateTime.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))).ToList();

        foreach (var group in grouped)
        {
            <h5 class="mt-4 mb-2 text-muted">@group.Key</h5>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-hover">
                    <tbody>
                        @foreach (var match in group)
                        {
                            bool isPlayed = match.MatchStatus == 4;
                            bool isLive = InnebandyStats.Services.MatchState.IsLive(match, now);
                            <tr>
                                <td class="text-muted small" style="width:130px; white-space:nowrap;">
                                    @match.MatchDateTime.ToString("yyyy-MM-dd HH:mm")
                                    @if (isLive)
                                    {
                                        <span class="live-badge ms-1">Live</span>
                                    }
                                </td>
                                <td class="text-end @(match.HomeTeam.Trim() == Model.FilterTeam ? "fw-bold" : "fw-semibold")" style="width:35%;">@match.HomeTeam</td>
                                <td class="text-center px-2" style="width:80px; white-space:nowrap;">
                                    @if (isPlayed && match.GoalsHomeTeam.HasValue && match.GoalsAwayTeam.HasValue)
                                    {
                                        <a asp-action="MatchView"
                                           asp-route-id="@match.MatchID"
                                           asp-route-competitionId="@Model.CompetitionId"
                                           class="badge bg-dark text-decoration-none fs-6 px-3 py-1">
                                            @match.GoalsHomeTeam – @match.GoalsAwayTeam
                                        </a>
                                    }
                                    else if (isLive)
                                    {
                                        <a asp-action="MatchView"
                                           asp-route-id="@match.MatchID"
                                           asp-route-competitionId="@Model.CompetitionId"
                                           class="badge bg-danger text-decoration-none fs-6 px-3 py-1" title="Pågår">
                                            @(match.GoalsHomeTeam.HasValue && match.GoalsAwayTeam.HasValue ? $"{match.GoalsHomeTeam} – {match.GoalsAwayTeam}" : "pågår")
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="MatchView"
                                           asp-route-id="@match.MatchID"
                                           asp-route-competitionId="@Model.CompetitionId"
                                           class="badge bg-secondary text-decoration-none fs-6 px-3 py-1" title="Inför matchen">
                                            vs
                                        </a>
                                    }
                                </td>
                                <td class="@(match.AwayTeam.Trim() == Model.FilterTeam ? "fw-bold" : "fw-semibold")" style="width:35%;">@match.AwayTeam</td>
                                <td class="text-muted small">@match.Venue</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var seasonId = localStorage.getItem('selectedSeasonId') || '43';
            var link = document.getElementById('seriesLink');
            if (link) {
                link.href = 'https://stats.innebandy.se/sasong/' + seasonId + '/serie/@Model.CompetitionId/serietabell';
            }
            initFavSeriesBtn(document.querySelector('.fav-series-btn'));
        });
    </script>
}
