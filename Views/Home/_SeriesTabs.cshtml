@model int
@{
    var active = ViewData["SeriesTab"] as string;
    var tabs = new[]
    {
        ("SeriesTable", "Serietabell"),
        ("Standings", "Spelarlista"),
        ("Matches", "Matcher"),
        ("Leaders", "Topplistor"),
        ("TeamStats", "Lagstatistik")
    };
}
<ul class="nav nav-tabs mb-4 series-tabs">
    @foreach (var (action, label) in tabs)
    {
        <li class="nav-item">
            @if (action == active)
            {
                <a class="nav-link active" aria-current="page" href="#">@label</a>
            }
            else
            {
                <a class="nav-link" asp-action="@action" asp-route-id="@Model">@label</a>
            }
        </li>
    }
</ul>
