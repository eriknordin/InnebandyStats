@model InnebandyStats.Models.SeriesTableViewModel
@{
    ViewData["Title"] = Model.CompetitionName + " – Tabell";
}

<div class="container mt-4">
    <h1 class="mb-1">
        <a id="seriesLink" href="#" target="_blank" class="text-decoration-none">@Model.CompetitionName</a>
        <button class="btn btn-sm ms-2 fav-btn fav-series-btn"
                data-id="@Model.CompetitionId"
                data-name="@Model.CompetitionName"
                title="Favoritmarkera serien">☆</button>
    </h1>

    <partial name="_SeriesTabs" model="Model.CompetitionId" view-data='new ViewDataDictionary(ViewData) { ["SeriesTab"] = "SeriesTable" }' />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <partial name="_ErrorAlert" model="Model.ErrorMessage" />
    }

    @if (Model.RecentMatches.Count > 0 || Model.LiveMatches.Count > 0 || Model.UpcomingMatches.Count > 0)
    {
        var listData = new ViewDataDictionary(ViewData) { ["CompetitionId"] = Model.CompetitionId };
        var colClass = Model.LiveMatches.Count > 0 ? "col-lg-4" : "col-md-6";
        <div class="row g-3 mb-4">
            <div class="@colClass">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Senaste resultat</div>
                    <div class="card-body py-2">
                        @if (Model.RecentMatches.Count > 0)
                        {
                            <partial name="_MatchDayList" model="Model.RecentMatches" view-data="listData" />
                        }
                        else
                        {
                            <div class="match-empty">Inga spelade matcher ännu.</div>
                        }
                    </div>
                </div>
            </div>
            @if (Model.LiveMatches.Count > 0)
            {
                <div class="@colClass">
                    <div class="card h-100 live-card">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <span>Pågår nu</span>
                            <span class="live-badge">Live</span>
                        </div>
                        <div class="card-body py-2">
                            <partial name="_MatchDayList" model="Model.LiveMatches" view-data="listData" />
                        </div>
                    </div>
                </div>
            }
            <div class="@colClass">
                <div class="card h-100">
                    <div class="card-header fw-semibold d-flex justify-content-between">
                        <span>Kommande matcher</span>
                        <a asp-action="Matches" asp-route-id="@Model.CompetitionId" class="small fw-normal">Alla matcher →</a>
                    </div>
                    <div class="card-body py-2">
                        @if (Model.UpcomingMatches.Count > 0)
                        {
                            <partial name="_MatchDayList" model="Model.UpcomingMatches" view-data="listData" />
                        }
                        else
                        {
                            <div class="match-empty">Inga kommande matcher.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="btn-group btn-group-sm mb-3" role="group" aria-label="Tabelltyp">
        @foreach (var (scope, label) in new[] { ("all", "Totalt"), ("home", "Hemma"), ("away", "Borta") })
        {
            <a asp-action="SeriesTable" asp-route-id="@Model.CompetitionId" asp-route-scope="@(scope == "all" ? null : scope)"
               class="btn @(Model.Scope == scope ? "btn-dark" : "btn-outline-dark")">@label</a>
        }
    </div>

    @if (Model.Table.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-info">Inga spelade matcher hittades för denna serie.</div>
    }

    @if (Model.Table.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Lag</th>
                        <th class="text-center">M</th>
                        <th class="text-center">V</th>
                        <th class="text-center">O</th>
                        <th class="text-center">F</th>
                        <th class="text-center d-none d-sm-table-cell">GM</th>
                        <th class="text-center d-none d-sm-table-cell">IM</th>
                        <th class="text-center">+/-</th>
                        <th class="text-center">P</th>
                        <th class="d-none d-md-table-cell">Form</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var team in Model.Table)
                    {
                        <tr>
                            <td>@rank</td>
                            <td>
                                <a asp-action="TeamView"
                                   asp-route-competitionId="@Model.CompetitionId"
                                   asp-route-teamName="@team.TeamName"
                                   class="text-decoration-none text-dark fw-semibold">@team.TeamName</a>
                                <button class="fav-inline fav-team-btn"
                                        data-name="@team.TeamName"
                                        data-competition-id="@Model.CompetitionId"
                                        title="Favoritmarkera lag">☆</button>
                                <a asp-action="TeamAnalysis"
                                   asp-route-competitionId="@Model.CompetitionId"
                                   asp-route-teamName="@team.TeamName"
                                   class="text-muted small ms-1" title="Analysera lag">📊</a>
                            </td>
                            <td class="text-center">@team.Played</td>
                            <td class="text-center">@team.Wins</td>
                            <td class="text-center">@team.Draws</td>
                            <td class="text-center">@team.Losses</td>
                            <td class="text-center d-none d-sm-table-cell">@team.GoalsFor</td>
                            <td class="text-center d-none d-sm-table-cell">@team.GoalsAgainst</td>
                            <td class="text-center">@(team.GoalDiff > 0 ? "+" : "")@team.GoalDiff</td>
                            <td class="text-center"><strong>@team.Points</strong></td>
                            <td class="d-none d-md-table-cell">
                                <span class="form-dots" title="Senaste matcherna, äldst till vänster">
                                    @foreach (var r in team.Form)
                                    {
                                        <span class="form-dot @r">@r</span>
                                    }
                                </span>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small">M=Matcher, V=Vinster, O=Oavgjorda, F=Förluster, GM=Gjorda mål, IM=Insläppta mål, +/-=Målskillnad, P=Poäng. Form = senaste fem matcherna.</p>
    }

    @if (Model.Projection != null && Model.Projection.Teams.Any(t => t.Played > 0))
    {
        var proj = Model.Projection;
        var showOdds = proj.RemainingMatches > 0;
        var n = proj.Teams.Count;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        string OddsText(double p) => p <= 0 ? "" : p < 0.005 ? "<1" : (p * 100).ToString("0");

        <div class="card mt-4">
            <div class="card-header fw-semibold">
                @(showOdds ? "Prognos för slutplacering" : "Förväntade poäng")
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle odds-table">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Lag</th>
                                <th class="text-center" title="Poäng">P</th>
                                <th class="text-center" title="Förväntade poäng utifrån gjorda och insläppta mål">xP</th>
                                <th class="text-center" title="Poäng jämfört med förväntat">±</th>
                                @if (showOdds)
                                {
                                    <th class="text-center" title="Snitt av slutpoäng i simuleringarna">Prognos</th>
                                    @for (var pos = 1; pos <= n; pos++)
                                    {
                                        <th class="pos">@pos</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in proj.Teams)
                            {
                                var diff = t.PointsAboveExpected;
                                <tr>
                                    <td class="ps-3">@t.Rank</td>
                                    <td class="text-nowrap">
                                        <a asp-action="TeamAnalysis" asp-route-competitionId="@Model.CompetitionId" asp-route-teamName="@t.TeamName"
                                           class="text-decoration-none text-dark fw-semibold">@t.TeamName</a>
                                    </td>
                                    <td class="text-center">@t.Points</td>
                                    <td class="text-center">@t.ExpectedPoints.ToString("0.0")</td>
                                    <td class="text-center @(diff >= 1 ? "diff-pos" : diff <= -1 ? "diff-neg" : "text-muted")">@(diff > 0 ? "+" : "")@diff.ToString("0.0")</td>
                                    @if (showOdds)
                                    {
                                        <td class="text-center fw-semibold">@t.ProjectedPoints.ToString("0")</td>
                                        @for (var pos = 0; pos < n; pos++)
                                        {
                                            var p = t.PositionOdds[pos];
                                            var alpha = p <= 0 ? 0 : 0.08 + 0.85 * p;
                                            <td class="odds" style="background: rgba(13,110,253,@alpha.ToString("0.###", inv)); @(p > 0.45 ? "color:#fff;" : "")"
                                                title="@t.TeamName slutar @(pos + 1): @((p * 100).ToString("0.0")) %">@OddsText(p)</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer small text-muted">
                <strong>xP</strong> = förväntade poäng i spelade matcher utifrån lagens målskapande (Poissonmodell).
                Positivt ± betyder fler poäng än målskillnaden motiverar.
                @if (showOdds)
                {
                    <span>Prognosen bygger på @proj.Simulations.ToString("N0", new System.Globalization.CultureInfo("sv-SE")) simuleringar av de @proj.RemainingMatches återstående matcherna; siffrorna är procent.</span>
                }
            </div>
        </div>
    }

    @if (Model.History != null)
    {
        var h = Model.History;
        const int left = 34, right = 12, top = 12, rowHeight = 22;
        int bottom = 28;
        int width = 800;
        int height = top + bottom + (h.TeamCount - 1) * rowHeight;
        double stepX = h.Rounds.Count > 1 ? (width - left - right) / (double)(h.Rounds.Count - 1) : 0;
        double X(int i) => left + i * stepX;
        double Y(int rankValue) => top + (rankValue - 1) * rowHeight;
        var labelEvery = Math.Max(1, (int)Math.Ceiling(h.Rounds.Count / 15.0));

        <div class="card mt-4 mb-4">
            <div class="card-header fw-semibold">Tabellplacering omgång för omgång</div>
            <div class="card-body">
                <svg class="chart-svg" id="positionChart" viewBox="0 0 @width @height" role="img" aria-label="Tabellplacering per omgång">
                    @for (var r = 1; r <= h.TeamCount; r++)
                    {
                        <line class="grid" x1="@left" x2="@(width - right)" y1="@Y(r)" y2="@Y(r)" opacity="0.4" />
                        @:<text x="@(left - 8)" y="@(Y(r) + 4)" text-anchor="end">@r</text>
                    }
                    @for (var i = 0; i < h.Rounds.Count; i += labelEvery)
                    {
                        @:<text x="@X(i).ToString(System.Globalization.CultureInfo.InvariantCulture)" y="@(height - 8)" text-anchor="middle">@h.Rounds[i]</text>
                    }
                    @foreach (var (team, ranks) in h.Ranks)
                    {
                        var points = string.Join(" ", ranks
                            .Select((rk, i) => (rk, i))
                            .Where(x => x.rk.HasValue)
                            .Select(x => FormattableString.Invariant($"{X(x.i):0.#},{Y(x.rk!.Value):0.#}")));
                        <polyline class="line" data-team="@team" points="@points">
                            <title>@team</title>
                        </polyline>
                    }
                </svg>
                <div class="text-muted small text-center mb-2">Omgång</div>
                <div class="chart-legend d-flex flex-wrap gap-1">
                    @foreach (var team in Model.Table)
                    {
                        <span class="badge bg-light text-dark border" data-team="@team.TeamName">@team.TeamName</span>
                    }
                </div>
                <p class="text-muted small mt-2 mb-0">Håll över eller klicka på ett lag för att markera det.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var seasonId = localStorage.getItem('selectedSeasonId') || '43';
            var link = document.getElementById('seriesLink');
            if (link) {
                link.href = 'https://stats.innebandy.se/sasong/' + seasonId + '/serie/@Model.CompetitionId/serietabell';
            }
            initFavSeriesBtn(document.querySelector('.fav-series-btn'));
            initFavTeamBtns('@Model.CompetitionId', @Json.Serialize(Model.CompetitionName));

            // Markera lag i placeringsdiagrammet
            var chart = document.getElementById('positionChart');
            if (!chart) return;
            var pinned = null;
            function highlight(team) {
                chart.querySelectorAll('.line').forEach(function (l) {
                    l.classList.toggle('highlight', l.dataset.team === team);
                    if (l.dataset.team === team) l.parentNode.appendChild(l);
                });
                document.querySelectorAll('.chart-legend .badge').forEach(function (b) {
                    b.classList.toggle('active', b.dataset.team === team);
                });
            }
            document.querySelectorAll('.chart-legend .badge, #positionChart .line').forEach(function (el) {
                el.addEventListener('mouseenter', function () { highlight(el.dataset.team); });
                el.addEventListener('mouseleave', function () { highlight(pinned); });
                el.addEventListener('click', function () {
                    pinned = pinned === el.dataset.team ? null : el.dataset.team;
                    highlight(pinned);
                });
            });
        });
    </script>
}
