@model SyncOverviewViewModel
@{
    ViewData["Title"] = "Mina matcher";
    var sv = new System.Globalization.CultureInfo("sv-SE");
    string When(DateTime t) => t.Date == InnebandyStats.Services.MatchState.SwedishToday
        ? "idag " + t.ToString("HH:mm", sv)
        : t.ToString("d MMM HH:mm", sv);
}

<div class="container mt-4">
    <div class="card mb-4" id="syncedData">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">Synkad data <span class="text-muted fw-normal small">· @Model.Competitions.Count @(Model.Competitions.Count == 1 ? "serie" : "serier")</span></span>
            @if (Model.LastReceivedAt is { } last)
            {
                <span class="text-muted small">Senast mottaget @When(last) · @Model.DocumentCount dokument</span>
            }
        </div>
        <div class="card-body">
            @if (Model.Competitions.Count == 0)
            {
                <p class="mb-1">Inga serier är synkade ännu.</p>
                <p class="text-muted small mb-0">Öppna en serie på <a href="https://stats.innebandy.se" target="_blank" rel="noopener">stats.innebandy.se</a> med Chrome-pluginet och sidopanelen aktiv – serien och dess matcher skickas hit automatiskt.</p>
            }
            else
            {
                <input type="search" id="syncSearch" class="form-control mb-3" placeholder="Sök serie, lag eller säsong…" autocomplete="off" aria-label="Sök bland synkade serier">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" id="syncTable">
                        <thead>
                            <tr>
                                <th>Serie</th>
                                <th class="d-none d-md-table-cell">Säsong</th>
                                <th class="text-end">Spelade</th>
                                <th>Matchdata</th>
                                <th class="d-none d-md-table-cell text-end">Uppdaterad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Competitions)
                            {
                                var search = string.Join(" ", new[] { c.Name, c.Category, c.Season }.Concat(c.Teams)).ToLowerInvariant();
                                <tr data-search="@search">
                                    <td>
                                        <a href="/Home/SeriesTable/@c.CompetitionId" class="fw-semibold text-decoration-none">@c.Name</a>
                                        <div class="text-muted small">@string.Join(" · ", new[] { c.Category, c.Season, $"{c.Teams.Count} lag" }.Where(s => !string.IsNullOrEmpty(s)))</div>
                                        <div class="team-hits small mt-1" hidden>
                                            @foreach (var team in c.Teams)
                                            {
                                                <a class="badge text-bg-light border text-decoration-none me-1 mb-1" hidden data-team="@team.ToLowerInvariant()"
                                                   href="/Home/TeamView?competitionId=@c.CompetitionId&teamName=@Uri.EscapeDataString(team)">@team</a>
                                            }
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell">@c.Season</td>
                                    <td class="text-end">@c.Played / @c.Matches</td>
                                    <td style="min-width:120px">
                                        @if (c.Played == 0)
                                        {
                                            <span class="text-muted small">Inga spelade</span>
                                        }
                                        else if (c.IsComplete)
                                        {
                                            <span class="badge text-bg-success">Komplett</span>
                                        }
                                        else
                                        {
                                            var percent = c.DetailsCollected * 100 / c.Played;
                                            <div class="small">@c.DetailsCollected av @c.Played matcher</div>
                                            <div class="progress" style="height:4px" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                                <div class="progress-bar bg-warning" style="width:@percent%"></div>
                                            </div>
                                        }
                                        @if (c.DetailsCollected > 0 && c.LineupsCollected < c.DetailsCollected)
                                        {
                                            <div class="text-muted small">@c.LineupsCollected @(c.LineupsCollected == 1 ? "laguppställning" : "laguppställningar")</div>
                                        }
                                    </td>
                                    <td class="d-none d-md-table-cell text-end text-muted small">@When(c.LastUpdatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p id="syncNoHits" class="text-muted small mt-2 mb-0" hidden>Inga synkade serier matchar sökningen.</p>
            }
            @if (Model.Competitions.Count > 0 && (!Model.HasSeasons || !Model.HasFederations))
            {
                <p class="text-muted small mt-3 mb-0">Säsongs- och förbundslistorna i menyn är inte synkade än – de skickas när du laddar valfri sida på stats.innebandy.se med pluginet.</p>
            }
        </div>
    </div>

    <h1 class="mb-3">Mina matcher</h1>

    <div id="noFavs" class="card mb-4" style="display:none;">
        <div class="card-body">
            <h5 class="card-title">Välkommen!</h5>
            <p class="mb-2">Här samlas senaste resultat och kommande matcher för dina favoriter.</p>
            <ol class="mb-0">
                <li>Välj säsong, förbund och serie i menyn ovan och klicka <strong>Hämta</strong>.</li>
                <li>Klicka på stjärnan <span class="text-warning">☆</span> vid seriens namn eller vid ett lag i tabellen.</li>
                <li>Kom tillbaka hit – dina matcher dyker upp automatiskt.</li>
            </ol>
        </div>
    </div>

    <div id="favContent" style="display:none;">
        <div class="d-flex flex-wrap gap-2 mb-3" id="filterChips"></div>

        <div id="loading" class="text-muted mb-3">
            <span class="spinner-border spinner-border-sm me-2"></span>Hämtar matcher…
        </div>
        <div id="loadErrors"></div>

        <div class="row g-3 mb-4" id="overview" style="display:none;">
            <div class="col-md-6 overview-col">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Senaste resultat <span class="text-muted fw-normal small">· senaste 7 dagarna</span></div>
                    <div class="card-body py-2" id="recentList"></div>
                </div>
            </div>
            <div class="col-md-6 overview-col" id="liveCol" style="display:none;">
                <div class="card h-100 live-card">
                    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                        <span>Pågår nu</span>
                        <span class="live-badge">Live</span>
                    </div>
                    <div class="card-body py-2" id="liveList"></div>
                    <div class="card-footer small text-muted py-1">Uppdateras automatiskt var 2:a minut.</div>
                </div>
            </div>
            <div class="col-md-6 overview-col">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Kommande matcher <span class="text-muted fw-normal small">· kommande 7 dagarna</span></div>
                    <div class="card-body py-2" id="upcomingList"></div>
                </div>
            </div>
        </div>

        <h4 class="mb-3" id="seriesHeading" style="display:none;">Mina serier</h4>
        <div class="row g-3" id="seriesCards"></div>
    </div>
</div>

@section Scripts {
<script>
// Sök bland synkade serier: filtrerar på serie, kategori, säsong och lag. Träffade lag visas som länkar.
document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('syncSearch');
    if (!input) return;
    const rows = [...document.querySelectorAll('#syncTable tbody tr')];
    const noHits = document.getElementById('syncNoHits');

    function filter() {
        const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        let visible = 0;
        rows.forEach(row => {
            const hit = terms.every(t => row.dataset.search.includes(t));
            row.hidden = !hit;
            if (hit) visible++;

            const hitsBox = row.querySelector('.team-hits');
            let teamHits = 0;
            row.querySelectorAll('[data-team]').forEach(a => {
                const show = hit && terms.length > 0 && terms.some(t => t.length >= 2 && a.dataset.team.includes(t));
                a.hidden = !show;
                if (show) teamHits++;
            });
            hitsBox.hidden = teamHits === 0;
        });
        noHits.hidden = visible > 0;
    }

    input.addEventListener('input', filter);
});

document.addEventListener('DOMContentLoaded', function () {
    const DAY_MS = 24 * 60 * 60 * 1000;
    const favSeries = getFavs(FAV_SERIES_KEY);
    const favTeams = getFavs(FAV_TEAMS_KEY);

    const seriesIds = new Set(favSeries.map(s => String(s.id)));
    const ids = [...new Set([...seriesIds, ...favTeams.map(t => String(t.competitionId)).filter(Boolean)])];

    if (ids.length === 0) {
        document.getElementById('noFavs').style.display = '';
        return;
    }
    document.getElementById('favContent').style.display = '';

    // Favoritlag per serie
    const teamsByComp = {};
    favTeams.forEach(t => {
        const key = String(t.competitionId);
        (teamsByComp[key] = teamsByComp[key] || new Set()).add(t.name.trim());
    });
    const isFavTeam = (compId, name) => !!teamsByComp[compId] && teamsByComp[compId].has(name);

    let competitions = [];
    let filter = 'all';

    // ── Datum ──────────────────────────────────────────────────────────────
    function startOfDay(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); }
    const today = startOfDay(new Date());

    function dayLabel(date) {
        const diff = Math.round((startOfDay(date) - today) / DAY_MS);
        if (diff === 0) return 'Idag';
        if (diff === -1) return 'Igår';
        if (diff === 1) return 'Imorgon';
        return date.toLocaleDateString('sv-SE', { weekday: 'long', day: 'numeric', month: 'long' });
    }
    function timeLabel(date) {
        return date.toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' });
    }

    // ── Rendering ──────────────────────────────────────────────────────────
    function matchRow(m, showComp) {
        const homeCls = isFavTeam(m.compId, m.homeTeam) ? 'mr-home fav-team' : 'mr-home';
        const awayCls = isFavTeam(m.compId, m.awayTeam) ? 'mr-away fav-team' : 'mr-away';
        const hasScore = m.goalsHome !== null && m.goalsAway !== null;
        const score = m.played
            ? '<span class="mr-score">' + m.goalsHome + '–' + m.goalsAway + '</span>'
            : m.live
                ? '<span class="mr-score live">' + (hasScore ? m.goalsHome + '–' + m.goalsAway : 'pågår') + '</span>'
                : '<span class="mr-score upcoming">vs</span>';
        const time = m.live ? '<span class="live-badge">Live</span>' : timeLabel(m.date);
        return '<a class="match-row" href="/Home/MatchView?id=' + m.matchId + '&competitionId=' + m.compId + '">'
            + '<span class="mr-time">' + time + '</span>'
            + '<span class="' + homeCls + '">' + escHtml(m.homeTeam) + '</span>'
            + score
            + '<span class="' + awayCls + '">' + escHtml(m.awayTeam) + '</span>'
            + (showComp ? '<span class="mr-comp">' + escHtml(m.compName) + '</span>' : '')
            + '</a>';
    }

    function dayList(matches, showComp, emptyText) {
        if (matches.length === 0)
            return '<div class="match-empty">' + emptyText + '</div>';
        let html = '', lastDay = null;
        matches.forEach(m => {
            const day = startOfDay(m.date).getTime();
            if (day !== lastDay) {
                html += '<div class="match-day">' + escHtml(dayLabel(m.date)) + '</div>';
                lastDay = day;
            }
            html += matchRow(m, showComp);
        });
        return html;
    }

    // Vilka matcher hör till översikten med aktuellt filter
    function inFilter(m) {
        const favMatch = isFavTeam(m.compId, m.homeTeam) || isFavTeam(m.compId, m.awayTeam);
        if (filter === 'teams') return favMatch;
        if (filter !== 'all') return m.compId === filter;
        return seriesIds.has(m.compId) || favMatch;
    }

    function renderOverview() {
        const all = competitions.flatMap(c => c.matches).filter(inFilter);
        const recentFrom = new Date(today.getTime() - 7 * DAY_MS);
        const upcomingTo = new Date(today.getTime() + 8 * DAY_MS);

        const recent = all.filter(m => m.played && m.date >= recentFrom)
            .sort((a, b) => b.date - a.date);
        const live = all.filter(m => m.live).sort((a, b) => a.date - b.date);
        const upcoming = all.filter(m => !m.played && !m.live && m.date >= today && m.date < upcomingTo)
            .sort((a, b) => a.date - b.date);

        // Pågående matcher får en egen kolumn mellan senaste och kommande
        document.getElementById('liveCol').style.display = live.length ? '' : 'none';
        document.querySelectorAll('#overview .overview-col').forEach(col => {
            col.classList.toggle('col-md-6', !live.length);
            col.classList.toggle('col-lg-4', !!live.length);
        });

        const showComp = filter === 'all' || filter === 'teams';
        document.getElementById('recentList').innerHTML = dayList(recent, showComp, 'Inga spelade matcher de senaste 7 dagarna.');
        document.getElementById('liveList').innerHTML = dayList(live, showComp, '');
        document.getElementById('upcomingList').innerHTML = dayList(upcoming, showComp, 'Inga matcher de kommande 7 dagarna.');
        document.getElementById('overview').style.display = '';
    }

    function miniTable(c) {
        const favs = teamsByComp[c.compId] || new Set();
        const rows = c.table.map((t, i) => ({ ...t, rank: i + 1 }));
        // Topp 5 plus favoritlag längre ner
        const shown = rows.filter(r => r.rank <= 5 || favs.has(r.teamName));
        if (shown.length === 0) return '';
        let html = '<table class="table table-sm mb-2"><thead><tr class="small text-muted">'
            + '<th>#</th><th>Lag</th><th class="text-center">M</th><th class="text-center">+/-</th><th class="text-center">P</th></tr></thead><tbody>';
        let prev = 0;
        shown.forEach(r => {
            if (r.rank > prev + 1)
                html += '<tr><td colspan="5" class="text-center text-muted small py-0">⋯</td></tr>';
            const cls = favs.has(r.teamName) ? ' class="fw-bold"' : '';
            html += '<tr' + cls + '><td>' + r.rank + '</td>'
                + '<td><a class="text-decoration-none text-reset" href="/Home/TeamAnalysis?competitionId=' + c.compId + '&teamName=' + encodeURIComponent(r.teamName) + '">' + escHtml(r.teamName) + '</a></td>'
                + '<td class="text-center">' + r.played + '</td>'
                + '<td class="text-center">' + (r.goalDiff > 0 ? '+' : '') + r.goalDiff + '</td>'
                + '<td class="text-center fw-semibold">' + r.points + '</td></tr>';
            prev = r.rank;
        });
        return html + '</tbody></table>';
    }

    function renderSeriesCards() {
        const cards = document.getElementById('seriesCards');
        const visible = competitions.filter(c =>
            filter === 'all' ? true :
            filter === 'teams' ? !!teamsByComp[c.compId] :
            c.compId === filter);

        document.getElementById('seriesHeading').style.display = visible.length ? '' : 'none';
        cards.innerHTML = visible.map(c => {
            const recent = c.matches.filter(m => m.played).sort((a, b) => b.date - a.date).slice(0, 5);
            const live = c.matches.filter(m => m.live).sort((a, b) => a.date - b.date);
            const upcoming = c.matches.filter(m => !m.played && !m.live && m.date >= today).sort((a, b) => a.date - b.date).slice(0, 5);
            return '<div class="col-lg-6"><div class="card h-100">'
                + '<div class="card-header d-flex justify-content-between align-items-center">'
                + '<a class="fw-semibold text-decoration-none" href="/Home/SeriesTable?id=' + c.compId + '">' + escHtml(c.compName) + '</a>'
                + '<a class="small" href="/Home/Matches?id=' + c.compId + '">Alla matcher →</a></div>'
                + '<div class="card-body">'
                + miniTable(c)
                // Kortet är smalt, så pågående matcher får full bredd före senaste/kommande
                + (live.length
                    ? '<div class="mb-3"><div class="fw-semibold small mb-1 text-danger">Pågår nu</div>' + dayList(live, false, '') + '</div>'
                    : '')
                + '<div class="row g-3"><div class="col-sm-6"><div class="fw-semibold small mb-1">Senaste</div>'
                + dayList(recent, false, 'Inga spelade matcher ännu.')
                + '</div><div class="col-sm-6"><div class="fw-semibold small mb-1">Kommande</div>'
                + dayList(upcoming, false, 'Inga kommande matcher.')
                + '</div></div></div></div></div>';
        }).join('');
    }

    function renderChips() {
        const chips = [{ key: 'all', label: 'Alla favoriter' }];
        if (favTeams.length) chips.push({ key: 'teams', label: '★ Mina lag' });
        competitions.forEach(c => chips.push({ key: c.compId, label: c.compName }));

        const el = document.getElementById('filterChips');
        el.innerHTML = chips.map(ch =>
            '<button type="button" class="btn btn-sm ' + (ch.key === filter ? 'btn-dark' : 'btn-outline-dark') + '" data-key="' + escHtml(ch.key) + '">'
            + escHtml(ch.label) + '</button>').join('');
        el.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
            filter = b.dataset.key;
            render();
        }));
    }

    function render() {
        renderChips();
        renderOverview();
        renderSeriesCards();
    }

    // ── Hämtning ───────────────────────────────────────────────────────────
    const query = ids.map(id => 'ids=' + encodeURIComponent(id)).join('&');
    const REFRESH_MS = 2 * 60 * 1000;
    let refreshTimer = null;

    function load() {
        return fetch('/Home/GetFixtures?' + query)
            .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(data => {
                const errors = [];
                competitions = [];
                document.getElementById('loadErrors').innerHTML = '';
                const nameFromFavs = id =>
                    (favSeries.find(s => String(s.id) === id) || {}).name
                    || (favTeams.find(t => String(t.competitionId) === id) || {}).competitionName
                    || ('Serie ' + id);

                data.forEach(c => {
                    const compId = String(c.competitionId);
                    if (c.error) { errors.push(nameFromFavs(compId)); return; }
                    const compName = c.competitionName || nameFromFavs(compId);
                    competitions.push({
                        compId,
                        compName,
                        table: c.table,
                        matches: c.matches.map(m => ({ ...m, compId, compName, date: new Date(m.dateTime) }))
                    });
                });

                // Favoritserier först, i den ordning de sparades
                competitions.sort((a, b) => {
                    const ai = ids.indexOf(a.compId), bi = ids.indexOf(b.compId);
                    return ai - bi;
                });

                if (errors.length)
                    document.getElementById('loadErrors').innerHTML =
                        '<div class="alert alert-warning py-2 small">Kunde inte hämta: ' + errors.map(escHtml).join(', ') + '</div>';

                render();

                // Uppdatera så länge någon match pågår
                clearTimeout(refreshTimer);
                if (competitions.some(c => c.matches.some(m => m.live)))
                    refreshTimer = setTimeout(load, REFRESH_MS);
            })
            .catch(err => {
                document.getElementById('loadErrors').innerHTML =
                    '<div class="alert alert-danger">Kunde inte hämta matcher: ' + escHtml(err.message) + '</div>';
            })
            .finally(() => { document.getElementById('loading').style.display = 'none'; });
    }

    load();
});
</script>
}
