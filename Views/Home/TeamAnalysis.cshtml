@model InnebandyStats.Models.TeamAnalysisViewModel
@{
    ViewData["Title"] = Model.TeamName + " – Analys";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="SeriesTable" asp-route-id="@Model.CompetitionId">@Model.CompetitionName</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="TeamView" asp-route-competitionId="@Model.CompetitionId" asp-route-teamName="@Model.TeamName">@Model.TeamName</a>
            </li>
            <li class="breadcrumb-item active">Analys</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <h1 class="mb-0">@Model.TeamName</h1>
        <button class="btn fav-btn fav-team-btn"
                data-name="@Model.TeamName"
                data-competition-id="@Model.CompetitionId"
                title="Favoritmarkera laget">☆</button>
        <button class="btn btn-outline-secondary btn-sm ms-2" id="addToCollectionBtn"
                data-team-name="@Model.TeamName"
                data-competition-id="@Model.CompetitionId"
                data-competition-name="@Model.CompetitionName">
            + Samling
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @* Table position card *@
            <div class="col-6 col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <div class="display-4 fw-bold text-primary">@(Model.TableRank > 0 ? "#" + Model.TableRank : "–")</div>
                        <div class="text-muted small">Serieplacering</div>
                    </div>
                </div>
            </div>
            @* Record card *@
            <div class="col-6 col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        @if (Model.TableEntry != null)
                        {
                            <div class="fs-4 fw-bold">@Model.TableEntry.Wins-@Model.TableEntry.Draws-@Model.TableEntry.Losses</div>
                            <div class="text-muted small">V-O-F (@Model.TotalPlayed matcher)</div>
                            <div class="mt-1"><span class="badge bg-dark fs-6">@Model.TableEntry.Points p</span></div>
                        }
                        else
                        {
                            <div class="text-muted">Ingen tabelldata</div>
                        }
                    </div>
                </div>
            </div>
            @* Goals card *@
            <div class="col-6 col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold">@Model.AvgGoalsFor.ToString("0.0") <span class="text-muted fs-6">– @Model.AvgGoalsAgainst.ToString("0.0")</span></div>
                        <div class="text-muted small">Snitt mål per match</div>
                        @if (Model.TableEntry != null)
                        {
                            <div class="mt-1 small text-muted">@Model.TableEntry.GoalsFor–@Model.TableEntry.GoalsAgainst tot</div>
                        }
                    </div>
                </div>
            </div>
            @* Streak card *@
            <div class="col-6 col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        @if (Model.CurrentWinStreak > 1)
                        {
                            <div class="fs-4 fw-bold text-success">@Model.CurrentWinStreak</div>
                            <div class="text-muted small">Raka vinster 🔥</div>
                        }
                        else if (Model.CurrentUnbeatenStreak > 1)
                        {
                            <div class="fs-4 fw-bold text-warning">@Model.CurrentUnbeatenStreak</div>
                            <div class="text-muted small">Matcher obesegrade</div>
                        }
                        else if (Model.TotalPlayed > 0)
                        {
                            <div class="fs-4 fw-bold text-danger">–</div>
                            <div class="text-muted small">Ingen aktiv serie</div>
                        }
                        else
                        {
                            <div class="fs-4 fw-bold text-muted">–</div>
                            <div class="text-muted small">Ingen matchdata</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            @* Left column *@
            <div class="col-lg-6">
                @* Recent matches *@
                @if (Model.RecentMatches.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">Senaste @Model.RecentMatches.Count matcher</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    @foreach (var m in Model.RecentMatches)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small" style="width:90px; white-space:nowrap;">
                                                @m.MatchDateTime.ToString("MM-dd HH:mm")
                                            </td>
                                            <td class="small text-muted" style="width:32px;">
                                                @(m.IsHome ? "H" : "B")
                                            </td>
                                            <td>@m.Opponent</td>
                                            <td class="text-end pe-2" style="width:80px; white-space:nowrap;">
                                                @if (m.GoalsFor.HasValue)
                                                {
                                                    <strong>@m.GoalsFor–@m.GoalsAgainst</strong>
                                                }
                                            </td>
                                            <td style="width:40px;">
                                                @if (!string.IsNullOrEmpty(m.ResultLabel))
                                                {
                                                    <span class="badge @m.ResultBadgeClass">@m.ResultLabel</span>
                                                }
                                            </td>
                                            <td style="width:30px;">
                                                <a asp-action="MatchView"
                                                   asp-route-id="@m.MatchID"
                                                   asp-route-competitionId="@Model.CompetitionId"
                                                   class="text-muted small">→</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Upcoming matches *@
                @if (Model.UpcomingMatches.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">Kommande matcher</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    @foreach (var m in Model.UpcomingMatches)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small" style="width:110px; white-space:nowrap;">
                                                @m.MatchDateTime.ToString("yyyy-MM-dd HH:mm")
                                            </td>
                                            <td class="small text-muted" style="width:32px;">
                                                @(m.IsHome ? "H" : "B")
                                            </td>
                                            <td>@m.Opponent</td>
                                            <td style="width:30px;">
                                                <a asp-action="MatchView"
                                                   asp-route-id="@m.MatchID"
                                                   asp-route-competitionId="@Model.CompetitionId"
                                                   class="text-muted small">→</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Home/Away stats *@
                @if (Model.TotalPlayed > 0)
                {
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">Hemma / Borta</div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-6 border-end">
                                    <div class="small text-muted mb-1">Hemma</div>
                                    <div class="fw-bold">@Model.HomeWins-@Model.HomeDraws-@Model.HomeLosses</div>
                                    <div class="small text-muted">@Model.HomePlayed matcher</div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted mb-1">Borta</div>
                                    <div class="fw-bold">@Model.AwayWins-@Model.AwayDraws-@Model.AwayLosses</div>
                                    <div class="small text-muted">@Model.AwayPlayed matcher</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Right column *@
            <div class="col-lg-6">
                @* Hot players / Form *@
                @if (Model.FormPlayers.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">
                            🔥 Heta spelare
                            <span class="text-muted fw-normal small">(senaste @Model.FormMatchCount matcher)</span>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Spelare</th>
                                        <th class="text-center">Mål</th>
                                        <th class="text-center">Assist</th>
                                        <th class="text-center fw-bold">P</th>
                                        <th class="text-center text-muted small">S:P</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fp in Model.FormPlayers)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <a asp-action="Player" asp-route-id="@fp.PlayerID" asp-route-competitionId="@Model.CompetitionId" class="text-decoration-none text-dark fw-semibold">@fp.Name</a>
                                            </td>
                                            <td class="text-center">@fp.FormGoals</td>
                                            <td class="text-center">@fp.FormAssists</td>
                                            <td class="text-center"><strong>@fp.FormPoints</strong></td>
                                            <td class="text-center text-muted small">@(fp.SeasonStats?.Points.ToString() ?? "–")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @* Top scorers (season) *@
                @if (Model.TopPlayers.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Poängligan</span>
                            <a asp-action="TeamView"
                               asp-route-competitionId="@Model.CompetitionId"
                               asp-route-teamName="@Model.TeamName"
                               class="btn btn-outline-secondary btn-sm">Alla spelare</a>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">#</th>
                                        <th>Spelare</th>
                                        <th class="text-center">Fdd</th>
                                        <th class="text-center">M</th>
                                        <th class="text-center">Mål</th>
                                        <th class="text-center">A</th>
                                        <th class="text-center">P</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var r = 1; }
                                    @foreach (var p in Model.TopPlayers.Take(10))
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">@r</td>
                                            <td>
                                                <a asp-action="Player" asp-route-id="@p.PlayerID" asp-route-competitionId="@Model.CompetitionId" class="text-decoration-none text-dark fw-semibold">@p.Name</a>
                                                <button class="fav-inline fav-player-btn" data-id="@p.PlayerID" data-name="@p.Name" title="Favoritmarkera">☆</button>
                                            </td>
                                            <td class="text-center text-muted small">@(p.BirthYear > 0 ? p.BirthYear.ToString() : "")</td>
                                            <td class="text-center">@p.Matches</td>
                                            <td class="text-center">@p.Goals</td>
                                            <td class="text-center">@p.Assists</td>
                                            <td class="text-center"><strong>@p.Points</strong></td>
                                        </tr>
                                        r++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.Stats != null && Model.Stats.Matches > 0)
        {
            var s = Model.Stats;
            var invariant = System.Globalization.CultureInfo.InvariantCulture;
            string Pct(double? v) => v.HasValue ? v.Value.ToString("0.0") + " %" : "–";

            <div class="row g-4">
                <div class="col-lg-6">
                    @* Specialteams *@
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">Spelstyrka och disciplin</div>
                        <div class="card-body">
                            <div class="row g-3 text-center">
                                <div class="col-6 col-md-4">
                                    <div class="stat-tile">
                                        <div class="value">@Pct(s.PowerPlayPercent)</div>
                                        <div class="label">Powerplay (@s.PowerPlayGoals/@s.PowerPlayOpportunities)</div>
                                        @if (Model.LeaguePowerPlayPercent.HasValue)
                                        {
                                            <div class="small text-muted">Serien: @Pct(Model.LeaguePowerPlayPercent)</div>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="stat-tile">
                                        <div class="value">@Pct(s.PenaltyKillPercent)</div>
                                        <div class="label">Boxplay (@s.PowerPlayGoalsAgainst insl. på @s.TimesShortHanded)</div>
                                        @if (Model.LeaguePenaltyKillPercent.HasValue)
                                        {
                                            <div class="small text-muted">Serien: @Pct(Model.LeaguePenaltyKillPercent)</div>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="stat-tile">
                                        <div class="value">@s.PenaltyMinutesAverage.ToString("0.0")</div>
                                        <div class="label">Utv.min per match</div>
                                    </div>
                                </div>
                                @if (s.MatchesWithShots > 0)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="stat-tile">
                                            <div class="value">@s.ShotsForAverage!.Value.ToString("0.0") <span class="fs-6 text-muted">– @s.ShotsAgainstAverage!.Value.ToString("0.0")</span></div>
                                            <div class="label">Skott per match</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4">
                                        <div class="stat-tile">
                                            <div class="value">@Pct(s.ShootingPercent)</div>
                                            <div class="label">Skotteffektivitet</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4">
                                        <div class="stat-tile">
                                            <div class="value">@Pct(s.SavePercent)</div>
                                            <div class="label">Räddningsprocent</div>
                                        </div>
                                    </div>
                                }
                                @if (s.ShortHandedGoals > 0)
                                {
                                    <div class="col-12 small text-muted">Dessutom @s.ShortHandedGoals mål i boxplay.</div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Poängpar *@
                    @if (Model.Duos.Any())
                    {
                        <div class="card mb-4">
                            <div class="card-header fw-semibold">Poängpar <span class="text-muted fw-normal small">(målskytt ← passning)</span></div>
                            <div class="card-body p-0">
                                <table class="table table-sm mb-0">
                                    <tbody>
                                        @foreach (var duo in Model.Duos)
                                        {
                                            <tr>
                                                <td class="ps-3">
                                                    <a asp-action="Player" asp-route-id="@duo.ScorerID" asp-route-competitionId="@Model.CompetitionId" class="text-decoration-none text-dark fw-semibold">@duo.Scorer</a>
                                                    <span class="text-muted">←</span>
                                                    <a asp-action="Player" asp-route-id="@duo.AssistID" asp-route-competitionId="@Model.CompetitionId" class="text-decoration-none text-dark">@duo.Assist</a>
                                                </td>
                                                <td class="text-end pe-3"><strong>@duo.Goals</strong> mål</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-lg-6">
                    @* Målfördelning *@
                    @{
                        const int width = 480, height = 200, left = 28, right = 8, top = 10, bottom = 30;
                        double mid = top + (height - top - bottom) / 2.0;
                        double half = (height - top - bottom) / 2.0 - 4;
                        var maxBar = Math.Max(1, Math.Max(s.GoalsForByInterval.Max(), s.GoalsAgainstByInterval.Max()));
                        double slot = (width - left - right) / 12.0;
                        string F(double v) => v.ToString("0.#", invariant);
                    }
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">När gör laget mål?</div>
                        <div class="card-body">
                            <svg class="chart-svg" viewBox="0 0 @width @height" role="img" aria-label="Mål per femminutersintervall">
                                <line class="grid" x1="@left" x2="@(width - right)" y1="@F(mid)" y2="@F(mid)" />
                                @for (var p = 1; p < 3; p++)
                                {
                                    var x = left + p * 4 * slot;
                                    <line class="grid" x1="@F(x)" x2="@F(x)" y1="@top" y2="@(height - bottom)" stroke-dasharray="3 3" />
                                }
                                @for (var i = 0; i < 12; i++)
                                {
                                    var x = left + i * slot + slot * 0.15;
                                    var w = slot * 0.7;
                                    var hf = s.GoalsForByInterval[i] / (double)maxBar * half;
                                    var ha = s.GoalsAgainstByInterval[i] / (double)maxBar * half;
                                    var label = $"P{i / 4 + 1} {i % 4 * 5}–{i % 4 * 5 + 5} min";
                                    <rect class="bar-for" x="@F(x)" y="@F(mid - hf)" width="@F(w)" height="@F(hf)"><title>@label: @s.GoalsForByInterval[i] gjorda</title></rect>
                                    <rect class="bar-against" x="@F(x)" y="@F(mid)" width="@F(w)" height="@F(ha)"><title>@label: @s.GoalsAgainstByInterval[i] insläppta</title></rect>
                                }
                                <text x="@(left - 4)" y="@(top + 10)" text-anchor="end">@maxBar</text>
                                <text x="@(left - 4)" y="@F(mid + 4)" text-anchor="end">0</text>
                                @for (var p = 0; p < 3; p++)
                                {
                                    @:<text x="@F(left + (p * 4 + 2) * slot)" y="@(height - 10)" text-anchor="middle">Period @(p + 1)</text>
                                }
                            </svg>
                            <div class="d-flex justify-content-center gap-3 small mb-3">
                                <span><span class="form-dot V" style="width:.8rem;height:.8rem;"></span> Gjorda</span>
                                <span><span class="form-dot F" style="width:.8rem;height:.8rem;"></span> Insläppta</span>
                            </div>
                            <table class="table table-sm mb-0 text-center">
                                <thead class="table-light">
                                    <tr><th></th><th>P1</th><th>P2</th><th>P3</th>@if (s.GoalsForByPeriod[3] + s.GoalsAgainstByPeriod[3] > 0) { <th>FL</th> }</tr>
                                </thead>
                                <tbody>
                                    @foreach (var (label, values) in new[] { ("Gjorda", s.GoalsForByPeriod), ("Insläppta", s.GoalsAgainstByPeriod) })
                                    {
                                        <tr>
                                            <td class="text-start">@label</td>
                                            @for (var p = 0; p < 3; p++) { <td>@values[p]</td> }
                                            @if (s.GoalsForByPeriod[3] + s.GoalsAgainstByPeriod[3] > 0) { <td>@values[3]</td> }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* Inbördes möten *@
                    @if (Model.HeadToHead.Any())
                    {
                        <div class="card mb-4">
                            <div class="card-header fw-semibold">Inbördes möten</div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">Motståndare</th>
                                                <th class="text-center">V-O-F</th>
                                                <th class="text-center">Mål</th>
                                                <th>Matcher</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var h in Model.HeadToHead)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <a asp-action="TeamAnalysis" asp-route-competitionId="@Model.CompetitionId" asp-route-teamName="@h.Opponent" class="text-decoration-none text-dark">@h.Opponent</a>
                                                    </td>
                                                    <td class="text-center text-nowrap">@h.Wins-@h.Draws-@h.Losses</td>
                                                    <td class="text-center text-nowrap">@h.GoalsFor–@h.GoalsAgainst</td>
                                                    <td>
                                                        @foreach (var m in h.Matches)
                                                        {
                                                            <a asp-action="MatchView" asp-route-id="@m.MatchID" asp-route-competitionId="@Model.CompetitionId"
                                                               class="badge @m.ResultBadgeClass text-decoration-none me-1"
                                                               title="@m.MatchDateTime.ToString("yyyy-MM-dd") @(m.IsHome ? "hemma" : "borta")">@m.GoalsFor–@m.GoalsAgainst</a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@* Collection modal *@
<div class="modal fade" id="collectionModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Lägg till i samling</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="collectionList" class="mb-3"></div>
                <div class="input-group input-group-sm">
                    <input type="text" id="newCollectionName" class="form-control" placeholder="Ny samling..." />
                    <button class="btn btn-primary" id="createCollectionBtn">Skapa</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initFavTeamBtns('@Model.CompetitionId', @Json.Serialize(Model.CompetitionName));
            initFavPlayerBtns('@Model.CompetitionId', @Json.Serialize(Model.CompetitionName));

            var teamName = @Json.Serialize(Model.TeamName);
            var competitionId = '@Model.CompetitionId';
            var competitionName = @Json.Serialize(Model.CompetitionName);

            // Collection modal
            var modal = new bootstrap.Modal(document.getElementById('collectionModal'));
            document.getElementById('addToCollectionBtn').addEventListener('click', function () {
                renderCollectionList(teamName, competitionId, competitionName);
                modal.show();
            });

            document.getElementById('createCollectionBtn').addEventListener('click', function () {
                var name = document.getElementById('newCollectionName').value.trim();
                if (!name) return;
                var col = createCollection(name);
                addTeamToCollection(col.id, teamName, competitionId, competitionName);
                renderFavMenu();
                document.getElementById('newCollectionName').value = '';
                renderCollectionList(teamName, competitionId, competitionName);
            });

            function renderCollectionList(teamName, competitionId, competitionName) {
                var cols = getCollections();
                var el = document.getElementById('collectionList');
                if (cols.length === 0) {
                    el.innerHTML = '<p class="text-muted small mb-0">Inga samlingar ännu.</p>';
                    return;
                }
                el.innerHTML = '';
                cols.forEach(function (col) {
                    var inCol = col.teams.some(t => t.name === teamName && t.competitionId == competitionId);
                    var btn = document.createElement('button');
                    btn.className = 'btn btn-sm w-100 mb-1 ' + (inCol ? 'btn-success' : 'btn-outline-secondary');
                    btn.textContent = (inCol ? '✓ ' : '') + col.name;
                    btn.addEventListener('click', function () {
                        if (inCol) {
                            removeTeamFromCollection(col.id, teamName, competitionId);
                            inCol = false;
                        } else {
                            addTeamToCollection(col.id, teamName, competitionId, competitionName);
                            inCol = true;
                        }
                        renderFavMenu();
                        renderCollectionList(teamName, competitionId, competitionName);
                    });
                    el.appendChild(btn);
                });
            }
        });
    </script>
}
